{
    "name": "kenyansdecision/public-opinion-engine",
    "description": "Independent Public Opinion & Civic Polling Platform for Kenya",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "check-syntax": "find app -name '*.php' -exec php -l {} \\;"
    }
}
